{
  "name": "spinstop",
  "version": "0.2.0",
  "description": "Stop AI agents from spinning: detect repeated, near-repeated and cyclic tool calls and block them before the tool runs (Vercel AI SDK and OpenAI Agents JS adapters, replay CLI).",
  "type": "module",
  "license": "MIT",
  "author": "LeeGyeongPil",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeeGyeongPil/spinstop.git"
  },
  "homepage": "https://github.com/LeeGyeongPil/spinstop#readme",
  "bugs": {
    "url": "https://github.com/LeeGyeongPil/spinstop/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "tool-calling",
    "loop-detection",
    "guardrail",
    "ai-sdk",
    "openai-agents"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ai": {
      "types": "./dist/adapters/ai.d.ts",
      "import": "./dist/adapters/ai.js"
    },
    "./openai-agents": {
      "types": "./dist/adapters/openai-agents.d.ts",
      "import": "./dist/adapters/openai-agents.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "spinstop": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.ko.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs",
    "demo": "npm run build && node examples/stuck-agent.mjs",
    "demo:agents": "npm run build && node examples/agents-js.mjs",
    "check:pack": "npm run build && node scripts/smoke-pack.mjs"
  },
  "peerDependencies": {
    "@openai/agents": "^0.21.0",
    "ai": ">=7 <8"
  },
  "peerDependenciesMeta": {
    "@openai/agents": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@openai/agents": "0.21.0",
    "@types/node": "22.20.5",
    "ai": "7.0.169",
    "typescript": "6.0.3",
    "zod": "4.6.7"
  }
}
